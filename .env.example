# ============================================================================
# HomeBot runtime secrets / config template.
#
#   1) Copy this file to `.env`  (the real .env is gitignored):
#        cp .env.example .env
#   2) Fill in the values you actually need.
#   3) Restart the app (`flutter run`) - `flutter_dotenv` reads this file
#      at startup via `dotenv.load()`.
#
# Anything you put here is also exposed via `dotenv.env['KEY_NAME']`.
# ============================================================================

# ============================================================================
# LLM providers — the chat screen has a selector so you can swap at runtime.
# Both keys are optional but at least one must be set or the assistant will
# be disabled.
# ============================================================================

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
# If unset, the "Gemini" segment of the chat selector stays disabled.
GEMINI_API_KEY=your-gemini-key-here
#
# Active Gemini model. `gemini-flash-latest` is the recommended alias —
# always resolves to the current stable Flash release and works for newly
# created API keys. Pinned names (e.g. `gemini-2.5-flash`) 404 for new
# keys with "no longer available to new users".
# GEMINI_MODEL=gemini-flash-latest

# OpenRouter — https://openrouter.ai/keys (one key works for every model
# on OpenRouter). Free models available — see
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Defaults to `meta-llama/llama-3.3-70b-instruct:free` if omitted.
# Any OpenRouter model id works, e.g.:
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat-v3-0324:free
#   qwen/qwen-2.5-72b-instruct:free
#   mistralai/mistral-7b-instruct:free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# Firebase  (values from `flutterfire configure` -> lib/firebase_options.dart)
# Copy them from your generated firebase_options.dart and paste below.
# ============================================================================

# Shared project identifiers
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# RTDB URL - find it under Firebase Console -> Realtime Database (usually
# https://<project-id>-default-rtdb.firebaseio.com). Required for the app
# to read/write `/devices`, `/sensors`, `/automation`, `/timers`.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Per-platform API keys + app IDs
FIREBASE_API_KEY_WEB=your-web-api-key
FIREBASE_APP_ID_WEB=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

FIREBASE_API_KEY_ANDROID=your-android-api-key
FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxxxxxxxxxxxxxxxx

FIREBASE_API_KEY_IOS=your-ios-api-key
FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxxxxxxxxxxxxxxxx

# iOS bundle identifier (must match the one set in Xcode / Firebase console)
FIREBASE_IOS_BUNDLE_ID=com.example.homeBot