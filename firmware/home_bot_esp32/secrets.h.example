// ============================================================================
// secrets.h.example  -  copy to `secrets.h` and fill in your real values.
// `secrets.h` is gitignored; never commit it.
// ============================================================================
#pragma once

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// From Firebase Console -> Project Settings -> General -> Your apps
// (Web app is fine for the ESP32 Firebase Arduino client.)
#define API_KEY         "AIza..."
#define DATABASE_URL    "https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app/"
// Optional: only needed if your RTDB rules require `auth != null`. Create
// the user in Firebase Console -> Authentication -> Users.
#define USER_EMAIL      "esp32@your-project.iam.gserviceaccount.com"
#define USER_PASSWORD   "your-firebase-auth-password"

// -----------------------------------------------------------------------
// DATABASE SECRET (recommended)
// -----------------------------------------------------------------------
// Get from:  Firebase Console -> Project Settings -> Service Accounts
//            -> Database Secrets -> (the long base64-ish string)
// If set, this REPLACES Email/Password sign-in and avoids the OAuth /
// NTP dependency. Leave "" to use USER_EMAIL / USER_PASSWORD instead.
#define DATABASE_SECRET ""

// Set USE_INSECURE_TLS to 1 ONLY for debugging handshake failures with
// "Failed to initialize the SSL layer". Disables server-cert verification
// so the ESP32 will accept any TLS cert Firebase presents. The TLS
// connection itself is still encrypted, but no MITM protection.
// Leave at 0 in production.
#define USE_INSECURE_TLS 0