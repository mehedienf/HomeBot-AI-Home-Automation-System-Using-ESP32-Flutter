#pragma once

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// From Firebase Console -> Project Settings -> General -> Your apps
// (Web app is fine for the ESP32 Firebase Arduino client.)
#define API_KEY         "AIza..."
#define DATABASE_URL    "https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app/"

// Optional: only needed if your RTDB rules require `auth != null`. Create
// the user in Firebase Console -> Authentication -> Users.
#define USER_EMAIL      "esp32@your-project.iam.gserviceaccount.com"
#define USER_PASSWORD   "your-firebase-auth-password"